{
  "info": {
    "name": "Lab05 — Хичээлд бүртгүүлэх API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "S01 Happy path: идэвхтэй, урьдач хангасан оюутан бүртгүүлэхэд 201 OK",
      "item": [
        {
          "name": "Setup: PUT /students/B242270084 (active, ['CS201'])",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/B242270084",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "B242270084"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"active\", \"coursesTaken\": [\"CS201\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: PUT /courses/CS313 (prereq ['CS201'])",
          "request": {
            "method": "PUT",
            "header": [
              {
