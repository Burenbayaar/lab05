            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Setup: 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /registrations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"studentID\": \"B242270084\", \"courseID\": \"CS313\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"result = OK\", function () {",
                  "    pm.expect(pm.response.json().result).to.eql(\"OK\");",
                  "});",
                  "pm.test(\"registrationID нь эерэг бүхэл тоо (яг утгыг шалгахгүй)\", function () {",
                  "    const id = pm.response.json().registrationID;",
                  "    pm.expect(id).to.be.a(\"number\");",
                  "    pm.expect(Number.isInteger(id) && id > 0).to.be.true;",
                  "    pm.collectionVariables.set(\"lastRegID\", id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /registrations (бүртгэл хадгалагдсан эсэх)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Шинэ бүртгэл GET /registrations жагсаалтад байна\", function () {",
                  "    const id = Number(pm.collectionVariables.get(\"lastRegID\"));",
                  "    const found = pm.response.json().find(r => r.registrationID === id);",
                  "    pm.expect(found).to.include({ studentID: \"B242270084\", courseID: \"CS313\" });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
